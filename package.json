{
  "name": "dakar-delivery-payments",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @dakar/server",
    "dev:web": "npm run dev -w @dakar/web",
    "build": "npm run build -w @dakar/web && npm run build -w @dakar/server",
    "typecheck": "npm run build -w @dakar/server && npm run build -w @dakar/web",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "start": "npm run start -w @dakar/server"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
